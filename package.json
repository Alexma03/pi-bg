{
	"name": "pi-bg",
	"version": "0.1.0",
	"private": true,
	"description": "Background tasks for Pi with wake-on-exit notices, plus a first-class Orca orchestration mailbox bridge for coordinator sessions.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"orca",
		"background-tasks"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"scripts": {
		"test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
		"typecheck": "tsc -p tsconfig.json"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.87.1",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@types/node": "^24.13.3",
		"typebox": "1.3.27",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alexma03/pi-bg.git"
	}
}
